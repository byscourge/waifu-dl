# hushlogin-type implementation to hide script usage

KILLSWITCH="$HOME/.waifulock"
if [[ -f "$KILLSWITCH" || -d "$KILLSWITCH" || -l "$KILLSWITCH" ]]; then
  exit 0
fi


SCRIPT="$(basename "$0")" # grab script name

print_err_msg() {
  echo "$SCRIPT: $1" >&2
  exit "${2:-1}"
}


# ------------------------------------------------------------------
# # # # # # #
# FUNCTIONS
# # # # # # #
# ------------------------------------------------------------------

#### HELP FUNCTIONS ----------------------------<<<<<<<<<
print_help() {
  printf '%s\n' "
$SCRIPT is a simple CLI tool: view or download random waifu images from waifu.im.

Docs:
  $SCRIPT --help: Show this help screen
  $SCRIPT --nsfw help: Show nsfw help screen
  $SCRIPT --view help: Show image viewer help screen
  $SCRIPT --output help: Show saveas help screen
  $SCRIPT --id help: Show id lookup help screen
  $SCRIPT --tag help: Show tag lookup help screen
  $SCRIPT --exclude help: Show tag exclusion help screen
  $SCRIPT --type help: Show type sort help screen
  $SCRIPT --sort help: Show sort type help screen
  $SCRIPT --orientation help: Show orientation sort help screen

Usage examples:
  $SCRIPT -ne -o animegirl.png [ Set mode to only NSFW and save the image to ./animegirl.png ]
  $SCRIPT -nb -t [ Set mode to all (NSFW+SFW) and open it with termux-open, for termux users. ]
  $SCRIPT -ne -vc [ Set mode to only NSFW and view the image with chafa ]
  $SCRIPT -p [ Print image URL ]
  $SCRIPT -vc -ne -ghentai [ Set mode to only NSFW, search the tag hentai and view the image with chafa ]
  $SCRIPT -vc -nn -gwaifu [ Set mode to no NSFW, search the tag waifu and view the image with chafa ]

All options in action:
  $SCRIPT --nsfw=exclusive --view=chafa --tag=hentai --exclude=ecchi --type=static --sort=popular --orientation=portrait --no-print
  
# -g is equivalent to --tag
# -G is equivalent to --exclude
# -a is equivalent to --type
# -r is equivalent to --orientation

Valid flags (17):

  $SCRIPT -h/--help [ Show help screen ]
  $SCRIPT --unihelp [ Print all help screens at once ]
  $SCRIPT -t/--termux [ Android: open media with termux-open ]
  $SCRIPT -p/--print [ Print URL ]
  $SCRIPT --no-print [ Force-disable URL printing ]
  $SCRIPT --raw [ Print pre-curl waifu.im URL ]
  $SCRIPT --json [ Print pre-jq waifu.im JSON ]

  $SCRIPT -o/--output (arg required) [ Save output as filename ]
  $SCRIPT -n/--nsfw (arg required) [ Set NSFW Mode ]
  $SCRIPT -v/--view (arg required) [ Set inline image viewer mode ]
  $SCRIPT -i/--id (arg required) [ Lookat specific waifu ID ]
  $SCRIPT -g/--tag (arg required) [ Set included tag ]
  $SCRIPT -G/--exclude (arg required) [ Set excluded tag ]
  $SCRIPT -a/--type (arg required) [ Set media type ]
  $SCRIPT -s/--sort (arg required) [ Set sort type ]
  $SCRIPT -r/--orientation (arg required) [ Set orientation type ]
  $SCRIPT --print-var (arg required) [ Print internal waifu variable ]

$SCRIPT has a killswitch mechanism:
if ~/.waifulock exists, it exits with no action.
"
}

